# Daily preview by default; ELS_BUILD_ALL=1 builds all five variants.
# Entry files are refreshed only when their generated contents change.
$pdf_mode = 1;                # pdflatex, output PDF directly
$bibtex_use = 1;              # run bibtex automatically when needed
$out_dir = '.';               # keep outputs in the project root (like compile_all.bat)
$preview_mode = 0;            # never auto-open a preview (editor shows the PDF itself)
$silence_logfile_warnings = 1;

# -----------------------------------------------------------------------------
# 1. Locate the main file: auto-detect *-main.tex (same rule as compile_all.bat)
# -----------------------------------------------------------------------------
my $MAIN;
my @candidates = glob('*-main.tex');
if (@candidates == 0) {
    die "latexmkrc: no *-main.tex main file found in the current directory.\n";
} elsif (@candidates > 1) {
    die "latexmkrc: multiple *-main.tex files found; keep only one: @candidates\n";
} else {
    $MAIN = $candidates[0];
}
(my $BASE = $MAIN) =~ s/\.tex$//;

# -----------------------------------------------------------------------------
# 2. Version table (the custom rule): variant name => \def switch for the main file
# -----------------------------------------------------------------------------
my @VERSIONS = (
    [ 'full',               '\def\ELSCleanMetadata{1}\def\ELSExportAuthors{1}'
                            . "\\def\\ELSAuthorsOutput{$BASE-authors.txt}"
                            . '\def\ELSShowAuthors{1}\def\FULL{1}' ],
    [ 'without-abstract',   '\def\ELSCleanMetadata{1}\def\ELSShowAuthors{1}\def\WITHOUTABSTRACT{1}' ],
    [ 'blind',              '\def\ELSCleanMetadata{1}\def\BLIND{1}\def\WITHOUTABSTRACT{1}' ],
    [ 'graphical-abstract', '\def\ELSCleanMetadata{1}\def\ELSShowAuthors{1}\def\GRAPHICALONLY{1}' ],
    [ 'highlights',         '\def\ELSCleanMetadata{1}\def\ELSShowAuthors{1}\def\HIGHLIGHTSONLY{1}' ],
);

# Version entry files: {base}-{ver}.tex, e.g. cas-dc-template-main-full.tex
my @ENTRIES;
for my $v (@VERSIONS) {
    push @ENTRIES, "$BASE-$v->[0].tex";
}

# -----------------------------------------------------------------------------
# 3. Auto-generate entries (refresh changed content only)
# -----------------------------------------------------------------------------
sub ensure_entries {
    for my $i (0 .. $#VERSIONS) {
        my ($ver, $defs) = @{ $VERSIONS[$i] };
        my $entry = $ENTRIES[$i];
        my $expected = "% Auto-generated by .latexmkrc -- do not edit.\n"
                     . "% !TEX program = pdflatex\n"
                     . "% !TEX root = $MAIN\n"
                     . "$defs\\input{$BASE}\n";
        my $existing = '';
        if (-e $entry) {
            open my $in, '<', $entry or die "Cannot read $entry: $!";
            local $/;
            $existing = <$in>;
            close $in;
            # Refuse to overwrite a handwritten file at a reserved entry name.
            die "latexmkrc: refusing to overwrite handwritten $entry\n"
                unless $existing =~ /^% Auto-generated by \.latexmkrc -- do not edit\./;
        }
        if (!-e $entry || $existing ne $expected) {
            open my $out, '>', $entry or die "Cannot write $entry: $!";
            print {$out} $expected;
            close $out or die "Cannot close $entry: $!";
            print "latexmkrc: updated version entry $entry\n";
        }
    }
}

ensure_entries();
my $BUILD_ALL = defined $ENV{ELS_BUILD_ALL} && $ENV{ELS_BUILD_ALL} eq '1';
@default_files = $BUILD_ALL ? @ENTRIES : ($MAIN);

# Explicit variant entries remain single builds even in all-version mode.
if ($BUILD_ALL) {
    my @new_args;
    for my $arg (@ARGV) {
        (my $arg_base = $arg) =~ s{^.*[\\/]}{};
        $arg_base =~ s/\.tex$//;
        if ($arg_base eq $BASE) {
            push @new_args, @ENTRIES;
        } else {
            push @new_args, $arg;
        }
    }
    @ARGV = @new_args;
}
